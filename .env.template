# ── LLM Agent ─────────────────────────────────────────────────────────────────
# Provider: claude | deepseek | openai | openrouter | local
LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-reasoner   # optional override

# Only the key for your chosen provider is required:
ANTHROPIC_API_KEY=      # claude      → https://console.anthropic.com
DEEPSEEK_API_KEY=       # deepseek    → https://platform.deepseek.com
OPENAI_API_KEY=         # openai      → https://platform.openai.com
OPENROUTER_API_KEY=     # openrouter  → https://openrouter.ai

# Local LLM — no key needed (Ollama / LM Studio / vLLM)
# LLM_PROVIDER=local
# LOCAL_LLM_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# ── AIS Maritime stream ────────────────────────────────────────────────────────
# https://aisstream.io — free tier available
AISSTREAM_API_KEY=

# ── ESA Copernicus Sentinel-2 ──────────────────────────────────────────────────
# https://dataspace.copernicus.eu — free registration
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ── Polymarket extended data ───────────────────────────────────────────────────
DOME_API_KEY=

# ── Internal ───────────────────────────────────────────────────────────────────
DB_PATH=data/alerts.db
LOG_LEVEL=INFO
