# SignalVortex Environment Configuration
# Copy this file to .env and fill in your API keys

# === Polygon.io (Options snapshots) ===
POLYGON_API_KEY=

# === Finnhub (Sentiment, insider trading, options) ===
FINNHUB_API_KEY=

# === Binance (Futures, open interest, long/short ratios) ===
# Note: Only required for private account access; public endpoints work without keys
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === Coinalyze (Historical OI, pattern detection) ===
COINANALYZE_API_KEY=

# === FRED (US monetary aggregates M2) ===
FRED_API_KEY=

# === GetDome (Polymarket overlay) ===
GETDOME_API_KEY=
GETDOME_POLYMARKET_TOKENS=

# === Massive.com (OHLC fallback) ===
MASSIVE_API_KEY=
# Optional S3 backfill
# MASSIVE_S3_ENDPOINT=https://files.massive.com
# MASSIVE_S3_BUCKET=flatfiles
# MASSIVE_S3_AWS_ACCESS_KEY_ID=
# MASSIVE_S3_AWS_SECRET_ACCESS_KEY=

# === SignalVortex Output ===
# Webhook URL for alerts (optional)
SIGNALVORTEX_WEBHOOK_URL=
# Output directory for CSV/JSON exports
SIGNALVORTEX_OUTPUT_DIR=./data
