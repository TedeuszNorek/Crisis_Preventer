    {
        "signal_id": "BTC_OI_SPIKE_1H",
        "intent": "Detect sudden Open Interest increase > 5% in 1 hour indicating leverage build-up.",
        "inputs": {
            "source": "binance",
            "entity_type": "instrument",
            "required_features": [
                "oi",
                "oi_1h_ago",
                "price",
                "volume"
            ]
        },
        "compute": {
            "aggregation": "none",
            "window_s": 3600
