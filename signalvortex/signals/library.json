            "min_consistency": 0.98
        },
        "drift_hooks": {
            "monitored_features": [
                "oi_change_pct"
            ],
            "baseline_window_d": 30,
            "metrics": [
                "KS",
                "PSI"
            ],
            "action_on_drift": "raise_confidence_threshold"
